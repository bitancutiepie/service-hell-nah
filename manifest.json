{
  "manifest_version": 3,
  "name": "SERVICE HELL NAH",
  "version": "5.0",
  "description": "Auto-completes ServiceNow and SkillWallet training videos, auto-navigates lessons, and inspects DOM.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SERVICE HELL NAH"
  },
  "permissions": [
    "tabs",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
